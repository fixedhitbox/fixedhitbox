<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <DSharpPlusVersion>5.0.0-nightly-02576</DSharpPlusVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="DSharpPlus" Version="$(DSharpPlusVersion)" />
